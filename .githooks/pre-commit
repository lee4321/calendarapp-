#!/bin/bash
# Pre-commit: type-check, lint, check formatting and test, then bump the
# CalVer version.
#
# Checks run against the working tree, not only what is staged, and take
# about 15 seconds. Skip them for one commit with `git commit --no-verify`.

set -e

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: uv is not on PATH, so the checks can't run." >&2
    echo "Install uv, or commit with --no-verify to skip them." >&2
    exit 1
fi

echo "pre-commit: uv check"
if ! uv check --locked --quiet >/dev/null 2>&1; then
    uv check --locked || true  # show the errors; set -e would stop here
    echo "pre-commit: type check failed (commit with --no-verify to skip)." >&2
    exit 1
fi

echo "pre-commit: ruff"
if ! uv run ruff check . --quiet >/dev/null 2>&1; then
    uv run ruff check . || true  # show the findings; set -e would stop here
    echo "pre-commit: ruff found problems (commit with --no-verify to skip)." >&2
    exit 1
fi

echo "pre-commit: ruff format"
if ! uv run ruff format --check . --quiet >/dev/null 2>&1; then
    uv run ruff format --check . || true  # list the files; set -e would stop here
    echo "pre-commit: files need formatting; run 'uv run ruff format .' (commit with --no-verify to skip)." >&2
    exit 1
fi

echo "pre-commit: pytest"
if ! uv run python -m pytest tests/ -q -p no:cacheprovider; then
    echo "pre-commit: tests failed (commit with --no-verify to skip)." >&2
    exit 1
fi

# docs/DefaultRendererValues.md quotes source line numbers, so almost any
# renderer edit — a comment included — makes it stale. Failing the commit
# over that would be noise, so regenerate and stage it the same way the
# version bump below does. tests/test_default_renderer_values.py guards the
# rows themselves (line numbers ignored) in case this hook is bypassed.
echo "pre-commit: DefaultRendererValues.md"
if ! uv run python tools/generate_default_renderer_values.py >/dev/null; then
    echo "pre-commit: could not regenerate docs/DefaultRendererValues.md." >&2
    echo "Fix the generator, or commit with --no-verify to skip." >&2
    exit 1
fi
# Stage it only when the commit already touches code it describes: the
# generator reads the working tree, so on an unrelated commit with dirty
# renderer edits this would otherwise sweep them into the document.
if git diff --cached --name-only | grep -qE '^(renderers/|visualizers/|config/)'; then
    git add docs/DefaultRendererValues.md
fi

FILE="ecalendar.py"

# Only update if ecalendar.py is staged
if git diff --cached --name-only | grep -q "^${FILE}$"; then
    TODAY=$(date +"%y.%m.%d")
    CURRENT=$(grep -o '__version__ = "[^"]*"' "$FILE" | sed 's/__version__ = "//;s/"//')

    # If current version starts with today's date, increment the build number
    if [[ "$CURRENT" == "$TODAY"* ]]; then
        N=$(echo "$CURRENT" | awk -F. '{print $4 + 1}')
    else
        N=0
    fi

    NEW_VERSION="${TODAY}.${N}"
    sed -i '' "s/^__version__ = .*/__version__ = \"${NEW_VERSION}\"/" "$FILE"
    git add "$FILE"
fi
