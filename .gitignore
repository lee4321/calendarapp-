# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Database (contains local data)
calendar.db

# Generated output
output/

# Local scratch area for files that don't belong in the repo
# (old DB backups, one-off exports, experiments)
attic/
*.bak.*
_completeness_*.xlsx

# Editor config
.vscode/

# Logs
*.log

# Theme migration converter output (regenerate with tools/migrate_theme.py)
config/themes/*.converted.yaml
config/themes/*.yaml.bak

# Icon staging folders. The icons the app draws live in calendar.db (loaded
# by importers/import_icons.py); these folders only ever held the SVG files
# on their way in, and tools/generate_capsule_numbers.py and
# tools/generate_sf_icons.py write here by default. Ignored so regenerating
# them does not fill the working folder again.
capsule_numbers/
sficons/
